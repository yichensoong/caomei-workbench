# 飞书自建应用配置
# 在 https://open.feishu.cn/ 创建自建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置
# Base Token: 从多维表格URL中获取，例如 https://my.feishu.cn/base/DGswbVURoag3f5sqcmYcxqxLned
FEISHU_BASE_TOKEN=DGswbVURoag3f5sqcmYcxqxLned

# 数据表ID（在多维表格中通过API获取或从URL中提取）
TABLE_TASKS=tblhk1DiCwtGlTgo
TABLE_ACCOUNTS=tblajEZ1YTqyTw96
TABLE_IDEAS=tblU0MnBhGNebare

# 服务端口
PORT=3000

# 允许的前端来源（CORS），部署后改为你的前端域名
ALLOWED_ORIGIN=*
